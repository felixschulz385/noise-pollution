# Data (regenerate via the pipeline; never commit bulk data). The data root is data/ in this
# repository unless noise_pollution.local.yaml sets another one.
/data/
/data_nobackup/
scratch_nobackup/

# Restricted data: figures and files that show restricted records
restricted/

# Logs
/log
*.log

# Secrets and local-only config
**/secrets
*.local.yaml
.env.local

# Editor / agent / OS artifacts (._* are macOS metadata files on network mounts)
.vscode/
.codex
.claude/
.DS_Store
._*

# Python build artifacts
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
.ipynb_checkpoints/

# LaTeX build files (output/documents/: the .tex sources and .pdf are tracked)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*-SAVE-ERROR
