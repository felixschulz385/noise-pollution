@misc{chenAirPollutionEducational2026,
	title = {Air {Pollution} and {Educational} {Inequality} in {China}: {The} {Role} of {Teacher} {Resource} {Crowding}},
	copyright = {https://creativecommons.org/licenses/by/4.0/},
	shorttitle = {Air {Pollution} and {Educational} {Inequality} in {China}},
	url = {https://www.researchsquare.com/article/rs-9675730/v1},
	doi = {10.21203/rs.3.rs-9675730/v1},
	abstract = {Abstract
          Education is widely regarded as the most reliable pathway out of intergenerational poverty, yet the insidious impact of environmental pollution on educational systems remains largely overlooked. Drawing on a decade-long city-level panel dataset encompassing 291 prefectural and provincial capital cities in China, we present the first causal evidence that air pollution undermines educational equity. A 1\% increase in PM₂.₅ concentration is associated with a 0.0137-unit rise in the middle-school student–teacher ratio — equivalent to approximately 0.37 standard deviations. This implies that a doubling of PM₂.₅ (a 100\% increase) corresponds to an average increase of about 0.95 students per teacher. The underlying mechanism follows a “brain-drain” rather than a “student-loss” narrative: escalating pollution drives away highly qualified teachers, eroding local human capital and, through a reinforcing feedback loop, diminishing the future supply of educators.},
	language = {en},
	urldate = {2026-08-06},
	publisher = {In Review},
	author = {Chen, Jinhuang},
	month = jul,
	year = {2026},
	file = {PDF:/Users/felixschulz/Zotero/storage/7TYD6RMA/Chen - 2026 - Air Pollution and Educational Inequality in China The Role of Teacher Resource Crowding.pdf:application/pdf},
}

