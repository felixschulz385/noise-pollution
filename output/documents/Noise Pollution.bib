@article{borzinoHeatAirPollution2026,
	title = {Heat, air pollution, and learning loss: global impacts on educational equity and human capital formation},
	volume = {5},
	issn = {2752-5295},
	shorttitle = {Heat, air pollution, and learning loss},
	url = {https://iopscience.iop.org/article/10.1088/2752-5295/ae8320},
	doi = {10.1088/2752-5295/ae8320},
	abstract = {Environmental stressors such as heat and air pollution are increasingly recognized as critical dimensions of climate risk, with implications that extend beyond health to educational performance and long-term economic development. This study examines the global association between chronic exposure to heat stress and fine particulate matter (PM2.5) and student learning outcomes, using harmonized exam data from the OECD Programme for International Student Assessment spanning 59 countries from 2000 to 2018. The sample covers a diverse range of low-, middle-, and high-income contexts, enabling a globally comparative analysis. We construct seasonal exposure metrics aligned with school calendars, using Wet Bulb Globe Temperature (WBGT) to more accurately capture thermal stress in humid environments. We find that a 1 ◦C increase in WBGTmax during school months is associated with a −0.0625 standard deviation (SD) decline in test scores—substantially larger than estimates based on annual averages. PM2.5 is likewise associated with lower student performance, and when combined with high pollution levels ({\textgreater}55 µg m−3), the association with heat is amplified: the marginal effect per additional 1 ◦C increases from −0.047 to −0.076 SD, reflecting a stronger association under dual exposure. Students in low-and middle-income countries show estimated learning losses more than twice as large as their peers in high-income countries. Under current conditions, these results correspond, in illustrative terms, to learning losses of up to 5.5 months, increasing to 7.5 months under a +2.5 ◦C warming scenario. These estimates represent illustrative, scenario-based projections of potential human-capital implications, including possible lifetime earnings losses ranging from 1.6\%–3.2\% under maintained conversion assumptions, with the steepest burdens falling on countries least equipped to adapt. Our findings highlight that safeguarding learning may need to become a core element of climate adaptation planning, requiring the integration of resilience measures into education policy and infrastructure investments to protect human capital in a warming world.},
	language = {en},
	number = {3},
	urldate = {2026-08-06},
	journal = {Environmental Research: Climate},
	author = {Borzino, Natalia and Otto, Matthias and Kjellstrom, Tord and Kai Wei Lee, Jason},
	month = sep,
	year = {2026},
	pages = {035029},
	file = {PDF:/Users/felixschulz/Zotero/storage/4DL4QM32/Borzino et al. - 2026 - Heat, air pollution, and learning loss global impacts on educational equity and human capital forma.pdf:application/pdf},
}

@techreport{nybergAirNoisePollution2025,
	type = {Working {Papers}},
	title = {Air and noise pollution: {A} state-of-the-art review of causal health outcomes},
	url = {https://ideas.repec.org/p/hhs/vtiwps/2025_006.html},
	abstract = {Air and noise pollution have in the medical literature been shown to have large negative health effects. However, the findings might exhibit the problem of endogeneity, i.e. that they are not causal. While literature focusing on causal relationships in the area has grown in the last decades, a comprehensive overview has not been performed in recent years. This study aims to provide a state-of-the-art review of the causal relationship between air and noise pollution and health outcomes by summarizing the findings from international peer-reviewed articles, as well as informing the reader of the methodological challenges in the field and knowledge gaps in the literature. In addition, we will contribute by comparing the economic literature regarding both air and noise pollution. To achieve these aims, we conducted a review of existing international literature. This review identified previous research linking air and noise pollution to health outcomes, focusing on causal estimations using primarily quasi-experimental settings. The empirical findings show that air pollution can be linked to several health outcomes, e.g., increased mortality, emergency room visits, and hospitalization, through different risk pathways. The number of studies focused on noise pollution are significantly fewer, with individual studies also finding negative health effects, e.g., sleeping problems, hypertension, and increased medication and healthcare utilization. The evaluation of air and noise pollution differs primarily in temporal aspects and the source of variation used.},
	number = {2025:6},
	institution = {Swedish National Road \& Transport Research Institute (VTI)},
	author = {Nyberg, Erik},
	month = nov,
	year = {2025},
	keywords = {Air pollution, Noise pollution, Health outcomes, Quasi-experimental design, State-of-the-art review},
	file = {PDF:/Users/felixschulz/Zotero/storage/NFWN7PKM/Nyberg - 2025 - Air and noise pollution A state-of-the-art review of causal health outcomes.pdf:application/pdf},
}

