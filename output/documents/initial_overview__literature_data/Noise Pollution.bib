@article{borzinoHeatAirPollution2026,
  title = {Heat, Air Pollution, and Learning Loss: Global Impacts on Educational Equity and Human Capital Formation},
  shorttitle = {Heat, Air Pollution, and Learning Loss},
  author = {Borzino, Natalia and Otto, Matthias and Kjellstrom, Tord and Kai Wei Lee, Jason},
  year = 2026,
  month = sep,
  journal = {Environmental Research: Climate},
  volume = {5},
  number = {3},
  pages = {035029},
  issn = {2752-5295},
  doi = {10.1088/2752-5295/ae8320},
  urldate = {2026-08-06},
  abstract = {Environmental stressors such as heat and air pollution are increasingly recognized as critical dimensions of climate risk, with implications that extend beyond health to educational performance and long-term economic development. This study examines the global association between chronic exposure to heat stress and fine particulate matter (PM2.5) and student learning outcomes, using harmonized exam data from the OECD Programme for International Student Assessment spanning 59 countries from 2000 to 2018. The sample covers a diverse range of low-, middle-, and high-income contexts, enabling a globally comparative analysis. We construct seasonal exposure metrics aligned with school calendars, using Wet Bulb Globe Temperature (WBGT) to more accurately capture thermal stress in humid environments. We find that a 1 \textopenbullet C increase in WBGTmax during school months is associated with a -0.0625 standard deviation (SD) decline in test scores---substantially larger than estimates based on annual averages. PM2.5 is likewise associated with lower student performance, and when combined with high pollution levels ({$>$}55 \textmu g m-3), the association with heat is amplified: the marginal effect per additional 1 \textopenbullet C increases from -0.047 to -0.076 SD, reflecting a stronger association under dual exposure. Students in low-and middle-income countries show estimated learning losses more than twice as large as their peers in high-income countries. Under current conditions, these results correspond, in illustrative terms, to learning losses of up to 5.5 months, increasing to 7.5 months under a +2.5 \textopenbullet C warming scenario. These estimates represent illustrative, scenario-based projections of potential human-capital implications, including possible lifetime earnings losses ranging from 1.6\%--3.2\% under maintained conversion assumptions, with the steepest burdens falling on countries least equipped to adapt. Our findings highlight that safeguarding learning may need to become a core element of climate adaptation planning, requiring the integration of resilience measures into education policy and infrastructure investments to protect human capital in a warming world.},
  langid = {english}
}

@misc{chenAirPollutionEducational2026,
  title = {Air {{Pollution}} and {{Educational Inequality}} in {{China}}: {{The Role}} of {{Teacher Resource Crowding}}},
  shorttitle = {Air {{Pollution}} and {{Educational Inequality}} in {{China}}},
  author = {Chen, Jinhuang},
  year = 2026,
  month = jul,
  publisher = {In Review},
  doi = {10.21203/rs.3.rs-9675730/v1},
  urldate = {2026-08-06},
  abstract = {Abstract           Education is widely regarded as the most reliable pathway out of intergenerational poverty, yet the insidious impact of environmental pollution on educational systems remains largely overlooked. Drawing on a decade-long city-level panel dataset encompassing 291 prefectural and provincial capital cities in China, we present the first causal evidence that air pollution undermines educational equity. A 1\% increase in PM{$_2$}.{$_5$} concentration is associated with a 0.0137-unit rise in the middle-school student--teacher ratio --- equivalent to approximately 0.37 standard deviations. This implies that a doubling of PM{$_2$}.{$_5$} (a 100\% increase) corresponds to an average increase of about 0.95 students per teacher. The underlying mechanism follows a ``brain-drain'' rather than a ``student-loss'' narrative: escalating pollution drives away highly qualified teachers, eroding local human capital and, through a reinforcing feedback loop, diminishing the future supply of educators.},
  archiveprefix = {In Review},
  copyright = {https://creativecommons.org/licenses/by/4.0/},
  langid = {english}
}

@article{chenIndustrializationPollutionLongterm2025,
  title = {Industrialization and Pollution: {{The}} Long-Term {{Impact}} of Early-Life Exposure on Human Capital Formation},
  shorttitle = {Industrialization and Pollution},
  author = {Chen, Pan},
  year = 2025,
  month = jan,
  journal = {Journal of Public Economics},
  volume = {241},
  pages = {105270},
  issn = {00472727},
  doi = {10.1016/j.jpubeco.2024.105270},
  urldate = {2026-08-06},
  abstract = {Air quality in developing countries is often much worse than in developed economies, yet evidence on the long-term human capital effects of air pollution in these settings is limited. This paper uses a cohort differencein-differences approach to examine the impact of early-life exposure to air pollution during China's 1950s industrialization on human capital formation. It assumes that economic opportunities linked to industrial plants impact upwind and downwind counties similarly within a 30-mile radius. The results indicate that moving from the 25th to 75th percentile of exposure reduces children's education by approximately 0.11 years. This effect size is notably larger than the impacts of three other factors affecting educational attainment in both China and the United States.},
  langid = {english}
}

@article{clarkEffectsRoadTraffic2010,
  title = {The Effects of Road Traffic and Aircraft Noise Exposure on Children{$\prime$}s Episodic Memory: {{The RANCH Project}}},
  shorttitle = {The Effects of Road Traffic and Aircraft Noise Exposure on Children{$\prime$}s Episodic Memory},
  author = {Clark, Charlotte and Martin, Rocio and Van Kempen, Elise and Haines, Mary and Barrio, IsabelLopez and Hygge, Staffan and Stansfeld, Stephen and Matheson, Mark},
  year = 2010,
  journal = {Noise and Health},
  volume = {12},
  number = {49},
  pages = {244},
  issn = {1463-1741},
  doi = {10.4103/1463-1741.70503},
  urldate = {2026-07-01},
  abstract = {Previous studies have found that chronic exposure to aircraft noise has a negative effect on children's performance on tests of episodic memory. The present study extended the design of earlier studies in three ways: firstly, by examining the effects of two noise sources, aircraft and road traffic, secondly, by examining exposure--effect relationships, and thirdly, by carrying out parallel field studies in three European countries, allowing cross-country comparisons to be made. A total of 2844 children aged between 8 years 10 months and 12 years 10 months (mean age 10 years 6 months) completed classroom-based tests of cued recall, recognition memory and prospective memory. Questionnaires were also completed by the children and their parents in order to provide information about socioeconomic context. Multilevel modeling analysis revealed aircraft noise to be associated with an impairment of recognition memory in a linear exposure--effect relationship. The analysis also found road traffic noise to be associated with improved performance on cued recall in a linear exposure--effect relationship. No significant association was found between exposure to aircraft noise and cued recall or prospective memory. Likewise, no significant association was found between road traffic noise and recognition or prospective memory. Taken together, these findings indicate that exposure to aircraft noise and road traffic noise can impact on certain aspects of children's episodic memory.},
  langid = {english}
}

@techreport{colmerGrandkidsArentAlright2020,
  type = {Working {{Papers}}},
  title = {The Grandkids Aren't Alright: {{The}} Intergenerational Effects of Prenatal Pollution Exposure},
  author = {Colmer, Jonathan and Voorheis, John},
  year = 2020,
  month = nov,
  number = {20-36},
  institution = {Center for Economic Studies, U.S. Census Bureau},
  doi = {None},
  abstract = {Evidence shows that environmental quality shapes human capital at birth with long-run effects on health and welfare. Do these effects, in turn, affect the economic opportunities of future generations? Using newly linked survey and administrative data, providing more than 150 million parent/child links, we show that regulation-induced improvements in air quality that an individual experienced in the womb increase the likelihood that their children, the second generation, attend college 40-50 years later. Intergenerational transmission appears to arise from greater parental resources and investments, rather than heritable, biological channels. Our findings suggest that within-generation estimates of marginal damages substantially underestimate the total welfare effects of improving environmental quality and point to the empirical relevance of environmental quality as a contributor to economic opportunity in the United States.}
}

